{
	"name": "vue-ai-template",
	"private": true,
	"version": "1.0.0",
	"author": "wp993080086 (https://github.com/wp993080086)",
	"license": "MIT",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vue-tsc --noEmit && vite build",
		"build:local": "vite build --mode local",
		"preview": "vite preview",
		"lint": "eslint src --fix",
		"fix": "eslint src --fix",
		"format": "prettier . --write",
		"typecheck": "vue-tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"prepare": "husky || true"
	},
	"dependencies": {
		"axios": "1.21.0",
		"pinia": "4.1.0",
		"vue": "3.5.44",
		"vue-router": "5.4.0"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.4",
		"@commitlint/config-conventional": "21.2.4",
		"@eslint/js": "10.0.1",
		"@types/node": "26.6.6",
		"@vitejs/plugin-vue": "6.0.10",
		"@vue/test-utils": "2.5.1",
		"@vue/tsconfig": "0.9.1",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-prettier": "5.5.7",
		"eslint-plugin-vue": "10.12.0",
		"globals": "17.14.0",
		"happy-dom": "21.0.4",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"prettier": "3.9.10",
		"sass": "1.107.1",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"vue-eslint-parser": "10.4.1",
		"vue-tsc": "3.3.14"
	},
	"lint-staged": {
		"*.{js,ts,vue,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{css,scss,json,md}": [
			"prettier --write"
		]
	},
	"engines": {
		"node": ">=22.23.4"
	},
	"browserslist": [
		"chrome >= 87",
		"firefox >= 78",
		"safari >= 14",
		"edge >= 88",
		"> 1%",
		"not dead"
	]
}
